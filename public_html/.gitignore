# ── Секреты и окружение ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Логи бота ────────────────────────────────────────────────────────────────
*.log
bot.log
logs/

# ── Базы данных (на всякий случай, если где-то рядом окажется sqlite-файл) ───
*.db
*.sqlite
*.sqlite3

# ── Сертификаты и ключи ──────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12

# ── Python / виртуальное окружение ───────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
.venv/
venv/
env/
.python-version

# ── Кэш инструментов ──────────────────────────────────────────────────────────
.pytest_cache/
.mypy_cache/
.ruff_cache/
.cache/

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp

# ── OS-мусор ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Бэкапы/временные файлы ────────────────────────────────────────────────────
*.bak
*.tmp
backups/
