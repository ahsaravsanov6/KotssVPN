# ── Секреты и окружение ──────────────────────────────────────────────────────
.env
.env.*
!.env.example

# ── Список серверов (содержит пароли от панелей) ─────────────────────────────
servers.yaml
*.servers.yaml

# ── Базы данных (любые, где бы они ни оказались по ошибке) ──────────────────
*.db
*.sqlite
*.sqlite3

# ── Сертификаты и ключи ──────────────────────────────────────────────────────
*.pem
*.key
*.crt
*.p12

# ── Логи ─────────────────────────────────────────────────────────────────────
*.log
logs/

# ── Кэш/временные файлы ──────────────────────────────────────────────────────
__pycache__/
*.pyc
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.venv/
venv/

# ── IDE ──────────────────────────────────────────────────────────────────────
.idea/
.vscode/

# ── Данные панелей / бэкапы ──────────────────────────────────────────────────
*.bak
backups/
